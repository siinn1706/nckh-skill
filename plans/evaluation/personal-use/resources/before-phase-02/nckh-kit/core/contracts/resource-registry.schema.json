{
  "additionalProperties": false,
  "properties": {
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "minLength": 1,
            "type": "string"
          },
          "consumers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "copied_vs_reauthored": {
            "const": "verbatim-upstream"
          },
          "dependency": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "domain": {
            "minLength": 1,
            "type": "string"
          },
          "expected_artifact": {
            "minLength": 1,
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "csv",
              "jsonl",
              "svg",
              "markdown"
            ]
          },
          "genre": {
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "const": "en"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "producer": {
            "minLength": 1,
            "type": "string"
          },
          "reader": {
            "minLength": 1,
            "type": "string"
          },
          "release_state": {
            "const": "experimental-local"
          },
          "requires": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "rollback": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "as_of": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "license": {
                "enum": [
                  "MIT",
                  "Apache-2.0"
                ]
              },
              "license_path": {
                "minLength": 1,
                "type": "string"
              },
              "license_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "notice_path": {
                "type": "string"
              },
              "notice_sha256": {
                "pattern": "^([a-f0-9]{64})?$",
                "type": "string"
              },
              "redistribution": {
                "const": "permitted-with-notices"
              },
              "repository": {
                "minLength": 1,
                "type": "string"
              },
              "review_reference": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "upstream_license_path": {
                "minLength": 1,
                "type": "string"
              },
              "upstream_path": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "pattern": "^[a-f0-9]{40}$",
                "type": "string"
              }
            },
            "required": [
              "repository",
              "version",
              "as_of",
              "license",
              "license_path",
              "license_sha256",
              "notice_path",
              "notice_sha256",
              "redistribution",
              "review_reference",
              "upstream_path",
              "sha256",
              "upstream_license_path"
            ],
            "type": "object"
          },
          "source_kind": {
            "const": "copied-upstream"
          }
        },
        "required": [
          "resource_id",
          "consumers",
          "path",
          "format",
          "reader",
          "producer",
          "requires",
          "dependency",
          "source",
          "source_kind",
          "copied_vs_reauthored",
          "release_state",
          "domain",
          "locale",
          "genre",
          "expected_artifact",
          "acceptance",
          "rollback"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "resources"
  ],
  "type": "object"
}
