{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "plan",
        "readout"
      ]
    },
    "frozen_at": {
      "type": "string",
      "minLength": 1
    },
    "freeze": {
      "description": "Null or value checked by owning semantic validator"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "dataset",
              "split",
              "telemetry",
              "analysis",
              "evaluation"
            ]
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "kind",
          "reference"
        ]
      }
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "oracles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_semantics": {
      "enum": [
        "computed-from-observed-data",
        "simulation"
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "not-used",
            "simulation"
          ]
        },
        "label": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "seed": {
          "description": "Null or value checked by owning semantic validator"
        },
        "replications": {
          "type": "integer",
          "minimum": 0
        },
        "warmup": {
          "type": "string"
        },
        "conservation": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "validity_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "applicability",
        "label",
        "generator",
        "parameters",
        "seed",
        "replications",
        "warmup",
        "conservation",
        "uncertainty",
        "validity_limits"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_calls": {
          "const": 0
        },
        "egress": {
          "const": "none"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "records": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "provider_calls",
        "egress",
        "attempts",
        "file_bytes",
        "aggregate_bytes",
        "records",
        "output_bytes"
      ]
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup_route": {
      "type": "string",
      "minLength": 1
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "previous_manifest": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "at",
          "reason",
          "previous_manifest"
        ]
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "predictions",
              "metrics",
              "statistics",
              "oracle",
              "readout"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "path"
        ]
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "experiment_id",
    "stage",
    "frozen_at",
    "freeze",
    "protocol",
    "inputs",
    "code",
    "config",
    "environment",
    "artifacts",
    "baselines",
    "metrics",
    "oracles",
    "output_semantics",
    "simulation",
    "limits",
    "grants",
    "cleanup_route",
    "amendments",
    "expected_outputs",
    "receipts",
    "outputs",
    "limitations"
  ]
}
