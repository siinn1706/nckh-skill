{
  "additionalProperties": false,
  "properties": {
    "adapter_revision": {
      "minLength": 1,
      "type": "string"
    },
    "agents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^nckh-[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "instructions_path": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "read_only": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "tier": {
            "enum": [
              "fast",
              "worker",
              "deep"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "tier",
          "read_only",
          "description",
          "instructions_path",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "closure_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "as_of": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "artifact_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "copied_vs_reauthored": {
                "enum": [
                  "verbatim-upstream",
                  "normalized-with-lineage",
                  "metadata-only-reference"
                ]
              },
              "license": {
                "enum": [
                  "MIT",
                  "Apache-2.0",
                  "BSD-3-Clause",
                  "CC-BY-4.0",
                  "CC-BY-SA-4.0"
                ]
              },
              "license_path": {
                "minLength": 1,
                "type": "string"
              },
              "license_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "notice_path": {
                "type": "string"
              },
              "notice_sha256": {
                "pattern": "^([a-f0-9]{64})?$",
                "type": "string"
              },
              "redistribution": {
                "enum": [
                  "permitted-with-notices",
                  "reference-only"
                ]
              },
              "repository": {
                "minLength": 1,
                "type": "string"
              },
              "review_reference": {
                "minLength": 1,
                "type": "string"
              },
              "source_kind": {
                "enum": [
                  "copied-upstream",
                  "retrieved-snapshot"
                ]
              },
              "upstream_path": {
                "minLength": 1,
                "type": "string"
              },
              "upstream_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "upstream_sha256s": {
                "items": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              },
              "version_kind": {
                "enum": [
                  "git-commit",
                  "mediawiki-oldid",
                  "pmcid-snapshot",
                  "api-snapshot",
                  "dataset-archive",
                  "swe-bench-task",
                  "normalized-bundle",
                  "reference-snapshot"
                ]
              },
              "rights_scope": {
                "enum": [
                  "redistributable",
                  "reference-only"
                ]
              },
              "retrieved_at": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$",
                "type": "string"
              },
              "retrieval_timezone": {
                "minLength": 1,
                "type": "string"
              },
              "lineage": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "source-response",
                        "rights-evidence",
                        "selection-query",
                        "archive-member",
                        "metadata"
                      ]
                    },
                    "locator": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "operation": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "upstream_sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "locator",
                    "sha256"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "repository",
              "version",
              "as_of",
              "license",
              "license_path",
              "license_sha256",
              "notice_path",
              "notice_sha256",
              "redistribution",
              "review_reference",
              "source_kind",
              "upstream_path",
              "upstream_sha256"
            ],
            "type": "object"
          },
          "rights": {
            "enum": [
              "owned-local-package",
              "copied-upstream"
            ]
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_path": {
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "source_path",
          "source_sha256",
          "rights"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "host": {
      "enum": [
        "claude",
        "codex",
        "cursor",
        "agy"
      ]
    },
    "kits": {
      "items": {
        "enum": [
          "core",
          "engineer",
          "marketing"
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "native_qualification": {
      "const": "unverified"
    },
    "package_version": {
      "minLength": 1,
      "type": "string"
    },
    "plugin": {
      "additionalProperties": false,
      "properties": {
        "agents_projected": {
          "type": "boolean"
        },
        "copied": {
          "const": false
        },
        "enabled": {
          "const": false
        },
        "manifest_path": {
          "type": "string"
        },
        "native_qualification": {
          "const": "unverified"
        },
        "projected": {
          "type": "boolean"
        },
        "registered": {
          "const": false
        },
        "session_only": {
          "const": false
        },
        "tested": {
          "const": false
        },
        "trusted": {
          "const": false
        }
      },
      "required": [
        "projected",
        "manifest_path",
        "agents_projected",
        "copied",
        "registered",
        "enabled",
        "trusted",
        "session_only",
        "tested",
        "native_qualification"
      ],
      "type": "object"
    },
    "release_rights": {
      "const": "local-package-only"
    },
    "representation": {
      "const": "shared-neutral"
    },
    "resource_access": {
      "enum": [
        "on",
        "off"
      ]
    },
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "consumer": {
            "minLength": 1,
            "type": "string"
          },
          "expected_artifact": {
            "minLength": 1,
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "csv",
              "jsonl",
              "svg",
              "markdown"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "reader": {
            "minLength": 1,
            "type": "string"
          },
          "requires": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "consumer",
          "path",
          "reader",
          "requires",
          "format",
          "source_sha256",
          "expected_artifact"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 2
    },
    "skills": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^nckh-[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "kit": {
            "enum": [
              "core",
              "engineer",
              "marketing",
              "tooling"
            ]
          },
          "status": {
            "const": "experimental"
          },
          "tree_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kit",
          "status",
          "tree_hash"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_lock_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "package_version",
    "host",
    "adapter_revision",
    "source_lock_hash",
    "closure_hash",
    "representation",
    "release_rights",
    "kits",
    "skills",
    "agents",
    "plugin",
    "files",
    "native_qualification",
    "resources",
    "resource_access"
  ],
  "type": "object"
}
