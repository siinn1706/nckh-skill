{
  "title": "Explicit project/task SVG engine binding",
  "description": "Integrity references supplied by a trusted task; this record does not grant authorization or establish final visual acceptance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "host": {"enum": ["claude", "codex", "cursor", "agy"]}
      },
      "required": ["project_root", "task_id", "host"]
    },
    "format": {"const": "svg"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "version": {"type": "string", "minLength": 1}
      },
      "required": ["executable", "sha256", "version"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["svg-render"]}
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version_receipt": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["path", "sha256"]
        },
        "render_receipt": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["path", "sha256"]
        },
        "input_svg": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["path", "sha256"]
        },
        "render_png": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["path", "sha256"]
        }
      },
      "required": ["version_receipt", "render_receipt", "input_svg", "render_png"]
    }
  },
  "required": ["schema_version", "scope", "format", "engine", "capabilities", "observations"]
}
