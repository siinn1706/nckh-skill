{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "host", "adapter_revision", "source_lock_hash", "closure_hash", "representation", "release_rights", "kits", "skills", "agents", "plugin", "files", "native_qualification"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "minLength": 1},
    "host": {"enum": ["claude", "codex", "cursor", "agy"]},
    "adapter_revision": {"type": "string", "minLength": 1},
    "source_lock_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "closure_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "representation": {"const": "shared-neutral"},
    "release_rights": {"const": "local-package-only"},
    "native_qualification": {"const": "unverified"},
    "kits": {"type": "array", "minItems": 1, "items": {"enum": ["core", "engineer", "marketing"]}},
    "plugin": {"type": "object", "additionalProperties": false,
      "required": ["projected", "manifest_path", "agents_projected", "copied", "registered", "enabled", "trusted", "session_only", "tested", "native_qualification"],
      "properties": {
        "projected": {"type": "boolean"}, "manifest_path": {"type": "string"}, "agents_projected": {"type": "boolean"},
        "copied": {"const": false}, "registered": {"const": false}, "enabled": {"const": false},
        "trusted": {"const": false}, "session_only": {"const": false}, "tested": {"const": false},
        "native_qualification": {"const": "unverified"}
      }
    },
    "agents": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "tier", "read_only", "description", "instructions_path", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^nckh-[a-z0-9]+(-[a-z0-9]+)*$"},
        "role": {"type": "string"}, "tier": {"enum": ["fast", "worker", "deep"]},
        "read_only": {"type": "boolean"}, "description": {"type": "string", "minLength": 1},
        "instructions_path": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }},
    "skills": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kit", "status", "tree_hash"],
      "properties": {
        "id": {"type": "string", "pattern": "^nckh-[a-z0-9]+(-[a-z0-9]+)*$"},
        "kit": {"enum": ["core", "engineer", "marketing", "tooling"]},
        "status": {"const": "experimental"},
        "tree_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }},
    "files": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "source_path", "source_sha256", "rights"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rights": {"const": "owned-local-package"}
      }
    }}
  }
}
