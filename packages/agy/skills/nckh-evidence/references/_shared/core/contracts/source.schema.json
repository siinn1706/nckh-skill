{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "access": {
      "enum": [
        "metadata",
        "abstract",
        "full-text",
        "user-supplied"
      ]
    },
    "rights": {
      "enum": [
        "owned",
        "cleared",
        "read-only",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "current",
        "corrected",
        "retracted",
        "unknown"
      ]
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "doi": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "translator": {
      "type": "string",
      "minLength": 1
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "metric_year": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        },
        "quartile": {
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "unknown"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "origin",
    "version",
    "sha256",
    "access",
    "rights",
    "status",
    "as_of"
  ]
}
