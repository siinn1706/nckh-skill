            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "enum": [
              "pending",
              "local-use-cleared",
              "redistributable"
