{
  "additionalProperties": false,
  "properties": {
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "minLength": 1,
            "type": "string"
          },
          "consumers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "copied_vs_reauthored": {
            "enum": [
              "verbatim-upstream",
              "normalized-with-lineage",
              "metadata-only-reference",
              "reauthored-with-sources"
            ]
          },
          "dependency": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "domain": {
            "minLength": 1,
            "type": "string"
          },
          "expected_artifact": {
            "minLength": 1,
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "csv",
              "jsonl",
              "svg",
              "markdown",
              "xml",
              "zip"
            ]
          },
          "genre": {
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "minLength": 2,
            "type": "string"
          },
          "limitations": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "producer": {
            "minLength": 1,
            "type": "string"
          },
          "reader": {
            "minLength": 1,
            "type": "string"
          },
          "release_state": {
            "const": "experimental-local"
          },
          "requires": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "rollback": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "as_of": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "license": {
                "enum": [
                  "MIT",
                  "Apache-2.0",
                  "BSD-3-Clause",
                  "CC-BY-4.0",
                  "CC-BY-SA-4.0",
                  "owned-local-package"
                ]
              },
              "license_path": {
                "minLength": 1,
                "type": "string"
              },
              "license_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "notice_path": {
                "type": "string"
              },
              "notice_sha256": {
                "pattern": "^([a-f0-9]{64})?$",
                "type": "string"
              },
              "redistribution": {
                "enum": [
                  "permitted-with-notices",
                  "reference-only",
                  "local-package-only"
                ]
              },
              "repository": {
                "minLength": 1,
                "type": "string"
              },
              "review_reference": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "upstream_license_path": {
                "minLength": 1,
                "type": "string"
              },
              "upstream_path": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              },
              "version_kind": {
                "enum": [
                  "git-commit",
                  "mediawiki-oldid",
                  "pmcid-snapshot",
                  "api-snapshot",
                  "dataset-archive",
                  "swe-bench-task",
                  "normalized-bundle",
                  "reference-snapshot",
                  "owned-authored"
                ]
              },
              "rights_scope": {
                "enum": [
                  "redistributable",
                  "reference-only",
                  "local-package-only"
                ]
              },
              "retrieved_at": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$",
                "type": "string"
              },
              "retrieval_timezone": {
                "minLength": 1,
                "type": "string"
              },
              "upstream_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "upstream_sha256s": {
                "items": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "lineage": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "source-response",
                        "rights-evidence",
                        "selection-query",
                        "archive-member",
                        "metadata"
                      ]
                    },
                    "locator": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "operation": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "upstream_sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "locator",
                    "sha256"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "license_kind": {
                "enum": [
                  "verbatim-upstream",
                  "owned-rights-record"
                ]
              }
            },
            "required": [
              "repository",
              "version",
              "as_of",
              "license",
              "license_path",
              "license_sha256",
              "notice_path",
              "notice_sha256",
              "redistribution",
              "review_reference",
              "sha256"
            ],
            "type": "object"
          },
          "source_kind": {
            "enum": [
              "copied-upstream",
              "retrieved-snapshot",
              "owned-reference"
            ]
          },
          "owned_provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": 1
              },
              "source_kind": {
                "const": "owned-reference"
              },
              "copied_vs_reauthored": {
                "const": "reauthored-with-sources"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "authoring_version": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "type": "string",
                "minLength": 1
              },
              "authoring_disposition": {
                "const": "original-summary-no-upstream-bytes"
              },
              "release_rights": {
                "const": "local-package-only"
              },
              "record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rights_record": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              "attribution_record": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              "contributions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version_kind": {
                      "enum": [
                        "git-commit",
                        "archive-snapshot",
                        "web-snapshot"
                      ]
                    },
                    "version_or_snapshot": {
                      "type": "string",
                      "minLength": 1
                    },
                    "upstream_commit": {
                      "description": "Verified 40 hex commit or null with unknown_reason."
                    },
                    "unknown_reason": {
                      "type": "string"
                    },
                    "observed_hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "as_of": {
                      "type": "string",
                      "minLength": 1
                    },
                    "license": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rights_scope": {
                      "const": "metadata-reference"
                    },
                    "attribution": {
                      "type": "string",
                      "minLength": 1
                    },
                    "transformation": {
                      "const": "concept-only-own-text"
                    },
                    "applicability": {
                      "type": "string",
                      "minLength": 1
                    },
                    "record_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "source_id",
                    "locator",
                    "version_kind",
                    "version_or_snapshot",
                    "upstream_commit",
                    "unknown_reason",
                    "observed_hash",
                    "as_of",
                    "license",
                    "rights_scope",
                    "attribution",
                    "transformation",
                    "applicability",
                    "record_ids"
                  ]
                }
              }
            },
            "required": [
              "schema_version",
              "source_kind",
              "copied_vs_reauthored",
              "artifact_sha256",
              "authoring_version",
              "as_of",
              "authoring_disposition",
              "release_rights",
              "record_ids",
              "rights_record",
              "attribution_record",
              "contributions"
            ]
          }
        },
        "required": [
          "resource_id",
          "consumers",
          "path",
          "format",
          "reader",
          "producer",
          "requires",
          "dependency",
          "source",
          "source_kind",
          "copied_vs_reauthored",
          "release_state",
          "domain",
          "locale",
          "genre",
          "expected_artifact",
          "acceptance",
          "rollback"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "resources"
  ],
  "type": "object"
}
