{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "static",
        "deterministic",
        "agent-behavior",
        "host-integration",
        "human-scientific"
      ]
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "logical_entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "actual_invocation": {
      "type": "string",
      "minLength": 1
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "resolved_model": {
      "type": "string",
      "minLength": 1
    },
    "effective_model": {
      "type": "string",
      "minLength": 1
    },
    "requested_effort": {
      "type": "string",
      "minLength": 1
    },
    "resolved_effort": {
      "type": "string",
      "minLength": 1
    },
    "effective_effort": {
      "type": "string",
      "minLength": 1
    },
    "permission_mode": {
      "type": "string",
      "minLength": 1
    },
    "sandbox": {
      "type": "string",
      "minLength": 1
    },
    "tool_trace_reference": {
      "type": "string",
      "minLength": 1
    },
    "egress_trace_reference": {
      "type": "string",
      "minLength": 1
    },
    "exit_status": {
      "type": "string",
      "minLength": 1
    },
    "output_status": {
      "type": "string",
      "minLength": 1
    },
    "cost_coverage": {
      "type": "string",
      "minLength": 1
    },
    "cost": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "skill_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "plugin_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "closure_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "command_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "shell": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "exit_status": {
            "type": "integer"
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "segment_exit_statuses": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "expected_nonzero": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "shell",
          "cwd",
          "exit_status",
          "stdout_sha256",
          "stderr_sha256",
          "expected_nonzero"
        ]
      }
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256_before": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256_after": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "eol_before": {
            "enum": [
              "none",
              "lf",
              "crlf",
              "cr",
              "mixed"
            ]
          },
          "eol_after": {
            "enum": [
              "none",
              "lf",
              "crlf",
              "cr",
              "mixed"
            ]
          },
          "mutation": {
            "enum": [
              "none",
              "authorized-with-preimage"
            ]
          },
          "preimage_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256_before",
          "sha256_after",
          "eol_before",
          "eol_after",
          "mutation"
        ]
      }
    },
    "output_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created_this_attempt": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "created_this_attempt"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "evidence_class",
    "host",
    "surface",
    "version",
    "logical_entrypoint",
    "mode",
    "actual_invocation",
    "requested_model",
    "resolved_model",
    "effective_model",
    "requested_effort",
    "resolved_effort",
    "effective_effort",
    "permission_mode",
    "sandbox",
    "tool_trace_reference",
    "egress_trace_reference",
    "exit_status",
    "output_status",
    "cost_coverage",
    "cost",
    "as_of",
    "skill_ids",
    "agent_ids",
    "plugin_ids",
    "input_hashes",
    "output_hashes",
    "checks",
    "limitations",
    "closure_hash",
    "command_results",
    "input_files",
    "output_files"
  ]
}
